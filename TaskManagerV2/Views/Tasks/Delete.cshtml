    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.TituloTarefa)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TituloTarefa)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DescricaoTarefa)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DescricaoTarefa)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DataInicio)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DataInicio)

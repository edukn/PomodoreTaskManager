        <dd>
            @Html.DisplayFor(model => model.PomodorosPlanejados)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.PomodorosEfetivos)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.PomodorosEfetivos)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Status)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Status)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Excluir" class="btn btn-default" /> |
            @Html.ActionLink("Voltar a lista de tarefas", "Index")
        </div>
    }
</div>

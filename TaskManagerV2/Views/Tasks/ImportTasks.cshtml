@model IEnumerable<TaskManagerV2.ClassLibrary.CalendarEvent>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewBag.Title = "Importar Tarefas";
}

<h2>Escolha uma tarefa</h2>

<table class="table">
    <tr>
        <th>
            Titulo
        </th>
        <th align="center">
            Descrição
        </th>
        <th align="center">
            Local
        </th>
        <th align="center">
            Data Inicial
        </th>
        <th align="center">
            Data Final
        </th>
    </tr>
    @foreach (var file in Model)
    {

        <tr>
            <td>
                @Html.DisplayFor(modelItem => file.Title) 
            </td>
            <td>
                @Html.DisplayFor(modelItem => file.Description) 
            </td>
            <td>
                @Html.DisplayFor(modelItem => file.Location) 
            </td>
            <td>
               @Html.DisplayFor(modelItem => file.StartDate) 
            </td>
            <td>
                @Html.DisplayFor(modelItem => file.EndDate)
            </td> 
            <td>
                @{ string t = file.Id;
                 //int pos = id.IndexOf('@');
                 //string t = id.Substring(0, pos);
                }
                <a href='@Url.Action("ImporterView", new { t })'>Importar</a>
            </td>
        </tr>
    }
</table>
